# Copy to .env and edit. `.env` is gitignored, and CI runs a secret scan over
# the working tree and the full git history on every push.
#
# Very little belongs here. What the gate decides — the targets, the windows,
# the thresholds, the budgets, the selectors — lives in the committed objectives
# file, because those are the things a reviewer has to see, and a setting that
# changes a verdict from an environment variable is a setting that changes a
# verdict invisibly. What is left is the handful of knobs that differ between a
# laptop and a CI runner, and none of them change what the gate decides.
#
# Variables are LLMOPS_<SECTION>__<FIELD>. There are exactly three sections:
# gate, log, export. Every section forbids unknown keys, and a misspelt section
# name is refused too — pydantic never builds a `logs` key for `extra="forbid"`
# to reject, so `load()` checks the section names itself. A typo here is an
# error with a remedy, not a line that is silently ignored.

# -- the gate ------------------------------------------------------------

# Time series a single metric may produce before the cardinality guard refuses
# it. See docs/cardinality.md. Raising this is almost always the wrong fix:
# the right one is to bucket the offending label.
LLMOPS_GATE__SERIES_BUDGET=1000

# Calls a burn rule needs in its long window before it will reach a verdict.
# Below it the rule reports "not evaluated" — which is not "passed", and is
# rendered in its own section by every report format.
#
# Lowering this to make a low-volume service evaluable is the tempting mistake.
# A rule firing on three calls is worse than no rule; lengthen the window
# instead. docs/burnrate.md has the argument and the measurements.
LLMOPS_GATE__MIN_SAMPLES=30

# -- diagnostics ---------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LLMOPS_LOG__LEVEL=INFO

# json for CI, console for a terminal. Logs always go to stderr — stdout
# carries the report, and a log line in the middle of a JSON document is a
# broken build with a confusing cause.
LLMOPS_LOG__FORMAT=console

# -- exporting -----------------------------------------------------------

# An OTLP/HTTP endpoint. Empty means nothing is exported, which is the default:
# a telemetry tool is precisely the component that should not surprise anyone by
# sending data somewhere.
#
# Setting this is not on its own enough. An exporter that opens a socket cannot
# be *constructed* without `--allow-network` on the command line, so a variable
# left in a CI job by mistake cannot start sending on its own. See ADR-007.
# LLMOPS_EXPORT__OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Seconds to wait for the collector. A zero timeout would make every export
# fail instantly, which looks like a collector outage rather than a
# configuration error, so the value is bounded rather than free.
LLMOPS_EXPORT__TIMEOUT_S=10.0

# -- what is deliberately not here ---------------------------------------
#
# There is no credential of any kind. This tool reads files and writes reports;
# it never authenticates to a model provider. If you export to a collector that
# needs an authorization header, supply it through your collector's own
# configuration rather than through this tool — and note that the redaction pass
# would strip such a header out of any report it appeared in.
