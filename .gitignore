# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key
secrets/

# Local runtime state. Note that examples/windows is NOT ignored: the
# synthesised corpus is part of the repository — it is what makes
# `git clone && python tasks.py check-incidents` work on a fresh checkout —
# and an over-broad rule over generated files would silently exclude it.
var/
*.db
*.sqlite
*.sqlite3
*.log

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build artifacts
*.sarif
sbom.json

# Generated by the task runner, never committed. The site is built from the
# Markdown already in the repository, and the audit requirements file is
# exported from uv.lock on every run of `python tasks.py security`.
_site/
requirements.audit.txt

# Reports the gate writes. The committed corpus is the input; the verdicts
# over it are reproducible from it, so they are an artefact, not a source.
reports/
